{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src", "packages/*/test", "scripts"]
}
